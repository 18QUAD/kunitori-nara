kipedia.org/w/index.php?title=%E7%9C%9F%E5%B2%A1%E5%B8%82&oldid=110809380"},{"id":"09209:national:104074736a44","cityId":"09209","category":"地理・自然","text":"真岡市には五行川が流れています。","source":"https://ja.wikipedia.org/w/index.php?title=%E7%9C%9F%E5%B2%A1%E5%B8%82&oldid=110809380"},{"id":"09209:national:627f32f9e642","cityId":"09209","category":"地域","text":"真岡市は、栃木県の南東部に位置する市です。","source":"https://ja.wikipedia.org/w/index.php?title=%E7%9C%9F%E5%B2%A1%E5%B8%82&oldid=110809380"}],"09210":[{"id":"09210:national:efbac2c9e56e","cityId":"09210","category":"地理・自然","text":"大田原市には那珂川が流れています。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%A4%A7%E7%94%B0%E5%8E%9F%E5%B8%82&oldid=110115689"},{"id":"09210:national:c3ec895084a6","cityId":"09210","category":"地理・自然","text":"大田原市には蛇尾川が流れています。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%A4%A7%E7%94%B0%E5%8E%9F%E5%B8%82&oldid=110115689"},{"id":"09210:national:a9d2679c67e9","cityId":"09210","category":"地域","text":"大田原市は、栃木県の北東部に位置する市です。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%A4%A7%E7%94%B0%E5%8E%9F%E5%B8%82&oldid=110115689"}],"09211":[{"id":"09211:national:dc1e9192300b","cityId":"09211","category":"地域","text":"矢板市は、栃木県北部に位置する市です。","source":"https://ja.wikipedia.org/w/index.php?title=%E7%9F%A2%E6%9D%BF%E5%B8%82&oldid=110986015"}],"09213":[{"id":"09213:national:f66e734b979d","cityId":"09213","category":"地理・自然","text":"那須塩原市には那珂川が流れています。","source":"https://ja.wikipedia.org/w/index.php?title=%E9%82%A3%E9%A0%88%E5%A1%A9%E5%8E%9F%E5%B8%82&oldid=110459796"},{"id":"09213:national:dab96d822133","cityId":"09213","category":"地理・自然","text":"那須塩原市には蛇尾川が流れています。","source":"https://ja.wikipedia.org/w/index.php?title=%E9%82%A3%E9%A0%88%E5%A1%A9%E5%8E%9F%E5%B8%82&oldid=110459796"},{"id":"09213:national:7f2a2df16d13","cityId":"09213","category":"地域","text":"那須塩原市は、栃木県北部に位置する市です。","source":"https://ja.wikipedia.org/w/index.php?title=%E9%82%A3%E9%A0%88%E5%A1%A9%E5%8E%9F%E5%B8%82&oldid=110459796"}],"09214":[{"id":"09214:nati