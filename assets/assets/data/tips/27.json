onal:8691ec0d1c7f","cityId":"27341","category":"文化・名所","text":"忠岡町民は全ランナー町内通過時に氏名放送される。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%BF%A0%E5%B2%A1%E7%94%BA&oldid=110743456"},{"id":"27341:national:96a4edbeb353","cityId":"27341","category":"地理・自然","text":"忠岡町には大津川が流れています。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%BF%A0%E5%B2%A1%E7%94%BA&oldid=110743456"},{"id":"27341:national:7956d57eeba7","cityId":"27341","category":"地理・自然","text":"忠岡町には牛滝川が流れています。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%BF%A0%E5%B2%A1%E7%94%BA&oldid=110743456"}],"27361":[{"id":"27361:national:181d6f1862b1","cityId":"27361","category":"地域","text":"熊取町の地には、中世に熊取荘という荘園がありました。","source":"https://ja.wikipedia.org/w/index.php?title=%E7%86%8A%E5%8F%96%E7%94%BA&oldid=110285581"}],"27362":[{"id":"27362:national:fb9d130df5a5","cityId":"27362","category":"地域","text":"田尻町は、大阪府泉南地域に位置し、泉南郡に属する町です。","source":"https://ja.wikipedia.org/w/index.php?title=%E7%94%B0%E5%B0%BB%E7%94%BA&oldid=111393298"}],"27366":[{"id":"27366:national:9cdc6ffb3914","cityId":"27366","category":"地域","text":"岬町は、大阪府泉南地域に位置する町です。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%B2%AC%E7%94%BA&oldid=110743577"}],"27381":[{"id":"27381:national:87d3e6af1ae3","cityId":"27381","category":"地域","text":"太子町は、大阪府南河内地域に位置し、南河内郡に属する町です。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%A4%AA%E5%AD%90%E7%94%BA+%28%E5%A4%A7%E9%98%AA%E5%BA%9C%29&oldid=110948521"}],"27382":[{"id":"27382:national:4363f57c98e8","cityId":"27382","category":"地域","text":"河南町は、大阪府南河内地域に位置し、南河内郡に属する町です。","source":"https://ja.wikipedia.org/w/index.php?title=%E6%B2%B3%E5%8D%97%E7%94%BA&oldid=110742488"}],"27383":[{"id":"27383:national:0c3024bc84ed","cityId":"27383","category":"文化・名所","text":"「赤阪城跡」は国指定の史跡です。","source":"https://kunishitei.bunka.go.jp/heritage/detail/401/1780"}]}}
