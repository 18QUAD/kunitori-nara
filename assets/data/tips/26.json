.org/w/index.php?title=%E4%BC%8F%E8%A6%8B%E5%8C%BA&oldid=111309990"}],"26110":[{"id":"26110:national:513806048f1d","cityId":"26110","category":"地理・自然","text":"京都市山科区は京都市にある行政区です。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%B1%B1%E7%A7%91%E5%8C%BA&oldid=108492679"}],"26111":[{"id":"26111:national:a66b291a0b59","cityId":"26111","category":"歴史","text":"西京区の山田地区には秦河勝末孫の東家の墓が京都市街を見守るように立っています。","source":"https://ja.wikipedia.org/w/index.php?title=%E8%A5%BF%E4%BA%AC%E5%8C%BA&oldid=107615719"}],"26201":[{"id":"26201:national:46cf70513188","cityId":"26201","category":"地理・自然","text":"市内最高海抜は三岳山の839.17mにまで及び、最低海抜は7.11mです。","source":"https://ja.wikipedia.org/w/index.php?title=%E7%A6%8F%E7%9F%A5%E5%B1%B1%E5%B8%82&oldid=111296547"},{"id":"26201:national:a676bd36271f","cityId":"26201","category":"歴史","text":"市の花・市の鳥・市の木・市民憲章が制定される。","source":"https://ja.wikipedia.org/w/index.php?title=%E7%A6%8F%E7%9F%A5%E5%B1%B1%E5%B8%82&oldid=111296547"},{"id":"26201:national:7b8e76a6607f","cityId":"26201","category":"地域","text":"福知山市は、京都府の北部に位置する市です。","source":"https://ja.wikipedia.org/w/index.php?title=%E7%A6%8F%E7%9F%A5%E5%B1%B1%E5%B8%82&oldid=111296547"}],"26202":[{"id":"26202:national:a5020ea49c6b","cityId":"26202","category":"文化・名所","text":"舞鶴市では近畿方言の一種である舞鶴弁が話される。","source":"https://ja.wikipedia.org/w/index.php?title=%E8%88%9E%E9%B6%B4%E5%B8%82&oldid=111023999"},{"id":"26202:national:39ebeeaeae35","cityId":"26202","category":"地理・自然","text":"市域にはほかにも宇野ヶ岳、赤岩山など600メートル級の山々が連なっています。","source":"https://ja.wikipedia.org/w/index.php?title=%E8%88%9E%E9%B6%B4%E5%B8%82&oldid=111023999"},{"id":"26202:national:8b884efcf7e3","cityId":"26202","category":"地理・自然","text":"舞鶴市にはほかに中舞鶴・加佐・大浦の3地区が存在する。","source":"https://ja.wikipedia.org/w/index.php?title=%E8%88%9E%E9%B6%B4%E5%B8%82&oldid=111023999"},{"id":"26202:national:85b3ee145f62","cityId":"26202","category":"歴史","text":"市内の河川が氾濫が発生して1934年の室戸台風以来の大水害となった。","source":"https://ja.wikipedia.org/w/index.php?title=%E8%88%9E%E9%B6%B4%E5%B8%82&oldid=111023999"}],"26203":[{"id":"26203:national:db7baa858549","cityId":"26203","category":"地域","text":"綾部市は、京都府北部に位置する市です。","source":"https://ja.wikipedia.org/w/index.php?title=%E7%B6%BE%E9%83%A8%E5%B8%82&oldid=111336772"}],"26204":[{"id":"26204:national:dc0c445e167b","cityId":"26204","category":"地域","text":"宇治市は、京都府の南に位置する市です。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%AE%87%E6%B2%BB%E5%B8%82&oldid=111416146"}],"26205":[{"id":"26205:national:6442a574ab33","cityId":"26205","category":"地域","text":"宮津市は、京都府北部にある市です。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%AE%AE%E6%B4%A5%E5%B8%82&oldid=111217719"},{"id":"26205:national:28fd63d2e139","cityId":"26205","category":"地域","text":"市の中心部は南部にあり、市街地が宮津湾に面しています。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%AE%AE%E6%B4%A5%E5%B8%82&oldid=111217719"}],"26206":[{"id":"26206:national:58fe4ade90d5","cityId":"26206","category":"地理・自然","text":"亀岡市は、亀岡盆地及び周辺山地を中心に位置しています。","source":"https://ja.wikipedia.org/w/index.php?title=%E4%BA%80%E5%B2%A1%E5%B8%82&oldid=111356521"},{"id":"26206:national:9590e063377b","cityId":"26206","category":"地域","text":"亀岡市は、京都府の中西部に位置する市です。","source":"https://ja.wikipedia.org/w/index.php?title=%E4%BA%80%E5%B2%A1%E5%B8%82&oldid=111356521"},{"id":"26206:national:cf2c0ab193a7","cityId":"26206","category":"地域","text":"亀岡市は丹波国の最南端に位置し、山城国・摂津国に接する。","source":"https://ja.wikipedia.org/w/index.php?title=%E4%BA%80%E5%B2%A1%E5%B8%82&oldid=111356521"}],"26207":[{"id":"26207:national:3722186b3ed9","cityId":"26207","category":"地域","text":"城陽市は、京都府の南部に位置する市です。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%9F%8E%E9%99%BD%E5%B8%82&oldid=111389039"}],"26208":[{"id":"26208:national:718f3ba1531f","cityId":"26208","category":"歴史","text":"市域からは大極殿跡が発掘されています。","source":"https://ja.wikipedia.org/w/index.php?title=%E5%90%91%E6%97%A5%E5%B8%82&oldid=111389074"},{"id":"26208:national:5b7bdae154e2","cityId":"26208","category":"地域","text":"向日市は、京都府の南西に位置する市です。","source":"https://ja.wik